<Window x:Class="Snake.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snake" Height="260" Width="400" MinHeight="260" MinWidth="400"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=UsernameInput}">
    <Grid Margin="24">
        <StackPanel x:Name="IdentityPanel">
            <TextBlock Text="Choose a username" FontSize="20" Margin="0,0,0,16" />
            <Label Content="_Username" Target="{Binding ElementName=UsernameInput}" Padding="0" />
            <TextBox x:Name="UsernameInput" Margin="0,4,0,0" />
            <TextBlock x:Name="ValidationMessage" Foreground="DarkRed" Margin="0,4,0,0" />
            <Button Content="Continue" IsDefault="True" HorizontalAlignment="Left"
                    Padding="16,6" Margin="0,12,0,0" Click="Continue_Click" />
        </StackPanel>
        <StackPanel x:Name="PlayerPanel" Visibility="Collapsed">
            <TextBlock Text="Player" FontSize="20" Margin="0,0,0,16" />
            <TextBlock x:Name="PlayerName" TextWrapping="Wrap" />
            <Button x:Name="ChangeUsernameButton" Content="Change username" HorizontalAlignment="Left"
                    Padding="16,6" Margin="0,16,0,0" Click="ChangeUsername_Click" />
        </StackPanel>
    </Grid>
</Window>
