<Window x:Class="Snake.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snake" Height="600" Width="720" MinHeight="500" MinWidth="560"
        Background="#101B1A" FontFamily="Segoe UI" Foreground="#F3F8F3"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown"
        FocusManager.FocusedElement="{Binding ElementName=UsernameInput}">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#B4F27A" />
            <Setter Property="Foreground" Value="#142213" />
            <Setter Property="BorderBrush" Value="#B4F27A" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="22,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#CBFFA0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#91D95C" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="50" Height="50" CornerRadius="15" Background="#263D31">
                <Canvas Width="36" Height="36">
                    <Path Data="M 7,25 L 19,25 Q 27,25 27,17 Q 27,10 20,10 L 12,10"
                          Stroke="#B4F27A" StrokeThickness="5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Ellipse Canvas.Left="7" Canvas.Top="7" Width="5" Height="5" Fill="#F5C96B" />
                </Canvas>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="SNAKE" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="PLAYER SETUP" FontSize="10" FontWeight="SemiBold"
                           Foreground="#A5B9A9" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#1B2A25" BorderBrush="#344C3B"
                BorderThickness="1" CornerRadius="18" Padding="30">
            <Grid>
                <Grid x:Name="IdentityPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="WELCOME, PLAYER" Foreground="#B4F27A"
                                   FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="Make your mark." FontSize="28" FontWeight="Bold"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="Choose a name to identify yourself in Snake."
                                   Foreground="#C0CFC2" FontSize="14" Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Label Grid.Row="1" Content="_Username" Target="{Binding ElementName=UsernameInput}"
                           Foreground="#F3F8F3" FontWeight="SemiBold" Padding="0"
                           Margin="0,24,0,6" />
                    <TextBox x:Name="UsernameInput" Grid.Row="2" FontSize="16"
                             Background="#101B1A" Foreground="#F3F8F3" CaretBrush="#F3F8F3"
                             BorderBrush="#78947D" BorderThickness="1" Padding="12,9"
                             VerticalContentAlignment="Center" />
                    <TextBlock x:Name="ValidationMessage" Grid.Row="3" Foreground="#FFB7A8"
                               Margin="0,6,0,0" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                    <Button Grid.Row="5" Content="Continue" IsDefault="True"
                            HorizontalAlignment="Left" Style="{StaticResource ActionButton}"
                            Margin="0,14,0,0" Click="Continue_Click" />
                </Grid>

                <Grid x:Name="PlayerPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="PLAYER IDENTIFIED" Foreground="#B4F27A"
                                   FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="Ready to slither." FontSize="28" FontWeight="Bold"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="You'll be known in the game as"
                                   Foreground="#C0CFC2" FontSize="14" Margin="0,6,0,0" />
                    </StackPanel>
                    <Border Grid.Row="1" Background="#101B1A" BorderBrush="#344C3B"
                            BorderThickness="1" CornerRadius="10" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Focusable="True" AutomationProperties.Name="Player name">
                            <TextBlock x:Name="PlayerName" FontSize="20" FontWeight="SemiBold"
                                       Foreground="#F3F8F3" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Play" Style="{StaticResource ActionButton}"
                                Click="Play_Click" />
                        <Button x:Name="ChangeUsernameButton" Content="Change username"
                                Style="{StaticResource ActionButton}" Margin="12,0,0,0"
                                Click="ChangeUsername_Click" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="GamePanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="GameMessage" FontSize="16" FontWeight="SemiBold"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="Use the arrow keys to steer." Foreground="#C0CFC2"
                                   Margin="0,4,0,8" />
                    </StackPanel>
                    <Viewbox Grid.Row="1" Stretch="Uniform">
                        <Canvas x:Name="GameBoard" Width="320" Height="240"
                                Background="#101B1A" />
                    </Viewbox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="RestartButton" Content="Restart"
                                Style="{StaticResource ActionButton}" Click="Play_Click" />
                        <Button Content="Back to player" Style="{StaticResource ActionButton}"
                                Margin="12,0,0,0" Click="BackToPlayer_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="YOUR NAME. YOUR GAME." Foreground="#A5B9A9"
                   FontSize="10" FontWeight="SemiBold" Margin="2,18,0,0" />
    </Grid>
</Window>
